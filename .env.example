###############################################################################
# General
###############################################################################

APP_NAME=Get Sepolia ETH
APP_ENVIRONMENT=production
SERVICE_STATUS=production

PAYMENT_ENABLED=true
ENABLE_DEV_STATUS_ENDPOINT=false

###############################################################################
# Database
###############################################################################

DATABASE_PATH=backend/sepolia_market.sqlite3

###############################################################################
# Frontend
###############################################################################

FRONTEND_ORIGIN=https://getsepolia.2bd.net

###############################################################################
# Orders
###############################################################################

ORDER_EXPIRY_MINUTES=60

CUSTOM_MIN=1
CUSTOM_MAX=500

DAILY_LIMIT_PER_WALLET=500

###############################################################################
# Faucet
###############################################################################

FAUCET_ENABLED=true

FAUCET_AMOUNT_ETH=0.02
FAUCET_COOLDOWN_HOURS=24

# Secret used for hashing client IPs (generate a random 32+ byte string)
FAUCET_IP_HASH_SECRET=replace-with-random-secret

###############################################################################
# Arbitrum payment verification
###############################################################################

ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
ARBITRUM_RPC_BACKUP_URLS=https://arbitrum-one-rpc.publicnode.com,\
https://public.1rpc.io/arb,\
https://rpc.nodeflare.app/arb/public

ARBITRUM_USDC_CONTRACT=0xaf88d065e77c8cC2239327C5EDb3A432268e5831

# Wallet that receives the USDC payments.
USDC_TREASURY_ADDRESS=
ARBITRUM_CONFIRMATIONS=1

###############################################################################
# Sepolia payout wallet
###############################################################################

SEPOLIA_RPC_URL=https://eth-sepolia-testnet.api.pocket.network
SEPOLIA_RPC_BACKUP_URLS=https://0xrpc.io/sep,\
https://ethereum-sepolia-rpc.publicnode.com

# Wallet that sends the Sepolia ETH payouts.
SEPOLIA_PAYOUT_ADDRESS=

# NEVER commit this private key.
SEPOLIA_PAYOUT_PRIVATE_KEY=

SEPOLIA_GAS_RESERVE_ETH=0.05

###############################################################################
# Payout worker
###############################################################################

PAYMENT_POLL_INTERVAL_SECONDS=5
PAYOUT_GAS_LIMIT=21000
PAYOUT_RECEIPT_TIMEOUT_SECONDS=600
PAYOUT_MAX_ATTEMPTS=5
SEPOLIA_PRIORITY_FEE_GWEI=1.0
SEPOLIA_MAX_FEE_MULTIPLIER=2.0
PAYOUT_LOG_LEVEL=INFO